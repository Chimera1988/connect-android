{
  "name": "connect-native-v2",
  "private": true,
  "version": "3.0.5",
  "main": "index.js",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "prebuild": "expo prebuild --platform android",
    "test": "node --test tests/*.test.cjs tests/*.test.mjs",
    "build:web": "vite build --config web/vite.config.ts && node scripts/embed-web.mjs",
    "typecheck:web": "tsc --project web/tsconfig.json --noEmit",
    "test:browser": "node scripts/test-cache-browser.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.0",
    "@notifee/react-native": "9.1.8",
    "@react-native-firebase/app": "27.1.0",
    "@react-native-firebase/messaging": "27.1.0",
    "@supabase/supabase-js": "2.57.0",
    "expo": "~58.0.0",
    "expo-audio": "~58.0.11",
    "expo-blur": "58.0.5",
    "expo-build-properties": "~58.0.12",
    "expo-camera": "~58.0.14",
    "expo-clipboard": "~58.0.4",
    "expo-crypto": "~58.0.7",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "58.0.22",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-video": "~58.0.13",
    "js-base64": "3.7.8",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-callkeep": "4.6.1",
    "react-native-incall-manager": "4.3.0",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "2.0.0",
    "react-native-webrtc": "155.0.1",
    "react-native-webview": "13.16.0",
    "tus-js-client": "4.3.1",
    "tweetnacl": "1.0.3"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "@types/react-dom": "19.2.2",
    "react-dom": "19.3.0",
    "typescript": "~6.0.3",
    "vite": "6.4.1",
    "vite-plugin-singlefile": "2.3.0"
  }
