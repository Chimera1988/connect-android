{
  "expo": {
    "name": "Connect Native",
    "slug": "connect-native-v2",
    "scheme": "connect",
    "version": "2.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "com.connect.messenger",
      "versionCode": 8,
      "permissions": [
        "INTERNET",
        "POST_NOTIFICATIONS",
        "RECORD_AUDIO",
        "CAMERA",
        "ACCESS_NETWORK_STATE",
        "CHANGE_NETWORK_STATE",
        "MODIFY_AUDIO_SETTINGS",
        "BLUETOOTH_CONNECT"
      ],
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/connect-icon.png",
        "backgroundColor": "#07121b"
      }
    },
    "plugins": [
      "expo-secure-store",
      "expo-image-picker",
      "expo-document-picker",
      [
        "expo-audio",
        {
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false
        }
      ],
      "expo-video",
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      [
        "expo-build-properties",
        {
          "android": {
            "extraMavenRepos": [
              "$rootDir/../node_modules/@notifee/react-native/android/libs"
            ]
          }
        }
      ],
      "./plugins/withConnectTelecom",
      [
        "expo-camera",
        {
          "recordAudioAndroid": true,
          "cameraPermission": "Камера нужна для записи видеокружков Connect.",
          "microphonePermission": "Микрофон нужен для записи видеокружков Connect."
        }
      ],
      "./plugins/withConnectSounds"
    ],
    "icon": "./assets/connect-icon.png"
  }
}
