{
  "expo": {
    "name": "Connect",
    "slug": "connect-native-v2",
    "scheme": "connect",
    "version": "3.0.2",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "com.connect.messenger",
      "versionCode": 20,
      "permissions": [
        "INTERNET",
        "POST_NOTIFICATIONS",
        "RECORD_AUDIO",
        "CAMERA",
        "ACCESS_NETWORK_STATE",
        "CHANGE_NETWORK_STATE",
        "MODIFY_AUDIO_SETTINGS",
        "BLUETOOTH_CONNECT"
      ],
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./plugins/launcher-icons/drawable-nodpi/ic_launcher_foreground.png",
        "backgroundImage": "./plugins/launcher-icons/drawable-nodpi/ic_launcher_background.png"
      }
    },
    "plugins": [
      "expo-secure-store",
      "expo-image-picker",
      "expo-document-picker",
      [
        "expo-audio",
        {
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": true
        }
      ],
      "expo-video",
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      [
        "expo-build-properties",
        {
          "android": {
            "extraMavenRepos": [
              "$rootDir/../node_modules/@notifee/react-native/android/libs"
            ],
            "minSdkVersion": 29,
            "enableMinifyInReleaseBuilds": false,
            "enableShrinkResourcesInReleaseBuilds": false,
            "buildArchs": [
              "armeabi-v7a",
              "arm64-v8a"
            ]
          }
        }
      ],
      "./plugins/withConnectTelecom",
      [
        "expo-camera",
        {
          "recordAudioAndroid": true,
          "cameraPermission": "Камера нужна для записи видеокружков Connect.",
          "microphonePermission": "Микрофон нужен для записи видеокружков Connect."
        }
      ],
      "./plugins/withConnectSounds",
      "./plugins/withConnectBuiltinSounds",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#090e14",
          "image": "./assets/connect-splash-bubbles.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#090e14",
            "image": "./assets/connect-splash-bubbles.png"
          }
        }
      ],
      "./plugins/withConnectWaveform",
      "./plugins/withConnectWebAssets",
      "./plugins/withConnectFiles",
      "./plugins/withConnectRelease",
      "./plugins/withConnectKeyboard",
      "./plugins/withConnectHistory",
      "./plugins/withConnectLauncherIcons"
    ],
    "icon": "./assets/connect-icon.png",
    "androidStatusBar": {
      "backgroundColor": "#090e14",
      "barStyle": "light-content"
    }
  }
}
